meta {
  name: Kreditoren synchronisieren
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/creditors?changed_since={{lastSyncTime}}&changed_until=2030-01-01T00:00:00Z
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  if (!bru.getVar("lastSyncTime")) {
    bru.setVar("lastSyncTime", "2020-01-01T00:00:00Z");
  }
}

script:post-response {
  if (res.status === 200 && res.body.items && res.body.items.length > 0) {
    bru.setVar("creditorId", res.body.items[0].id);
  }
}

docs {
  Delta-Abruf der Kreditoren. Erste ID wird als {{creditorId}} gespeichert.
}
