meta {
  name: Konten synchronisieren
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/accounts?changed_since={{lastSyncTime}}&changed_until=2030-01-01T00:00:00Z
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  if (!bru.getVar("lastSyncTime")) {
    bru.setVar("lastSyncTime", "2020-01-01T00:00:00Z");
  }
}

script:post-response {
  if (res.status === 200 && res.body.items && res.body.items.length > 0) {
    bru.setVar("accountId", res.body.items[0].id);
  }
}

docs {
  Liste der Konten. Das Zeitfenster wird angenommen, aber nicht angewendet: die Antwort ist
  immer der volle Bestand. Erste ID wird als {{accountId}} gespeichert (Eingabe für
  'Rechnung erstellen').
}
