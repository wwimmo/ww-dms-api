meta {
  name: Portfolios synchronisieren
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/portfolios?changed_since={{lastSyncTime}}&changed_until=2030-01-01T00:00:00Z
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  if (!bru.getVar("lastSyncTime")) {
    bru.setVar("lastSyncTime", "2020-01-01T00:00:00Z");
  }
}

script:post-response {
  if (res.status === 200 && res.body.items && res.body.items.length > 0) {
    bru.setVar("portfolioId", res.body.items[0].id);
  }
}

docs {
  Delta-Abruf der Portfolios. Erste ID wird als {{portfolioId}} gespeichert.
}
