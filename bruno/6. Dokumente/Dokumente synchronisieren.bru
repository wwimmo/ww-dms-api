meta {
  name: Dokumente synchronisieren
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/documents?changed_since={{lastSyncTime}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:pre-request {
  if (!bru.getVar("lastSyncTime")) {
    bru.setVar("lastSyncTime", "2020-01-01T00:00:00Z");
  }
}

script:post-response {
  if (res.status === 200 && res.body.items && res.body.items.length > 0) {
    bru.setVar("documentId", res.body.items[0].id);
  }
}

docs {
  Delta-Abruf der Dokumente (paginiert, Link-Header mit next). Erste ID wird als
  {{documentId}} gespeichert. Ohne changed_since liefert der Endpunkt den Vollbestand.
}
