meta {
  name: Dokumentinhalt herunterladen
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/documents/{{archiveDocumentId}}/content
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Streamt die Datei mit 200, Content-Type = gespeicherter MIME-Typ (z. B. application/pdf)
  und Content-Disposition: attachment; filename="…". Keine Weiterleitung, kein CDN.
}
